+    def sample_next_action(
+        self,
+        feat_a_now,  # [n_agent, hidden_dim]
+        tokenized_agent: Dict[str, torch.Tensor],
+        sampling_scheme: DictConfig,
+        pos_now,  # [n_agent, 2]
+        head_now,  # [n_agent]
+        n_step: int,
+    ):
+        """Action hook: token head + top-k sampling. Subclasses may replace the head."""
+        next_token_logits = self.token_predict_head(feat_a_now)
+        next_token_idx, next_token_traj_all = sample_next_token_traj(
+            token_traj=tokenized_agent["token_traj"],
+            token_traj_all=tokenized_agent["token_traj_all"],
+            sampling_scheme=sampling_scheme,
+            # ! for most-likely sampling
+            next_token_logits=next_token_logits,
+            # ! for nearest-pos sampling
+            pos_now=pos_now,  # [n_agent, 2]
+            head_now=head_now,  # [n_agent]
+            pos_next_gt=tokenized_agent["gt_pos_raw"][:, n_step],  # [n_agent, 2]
+            head_next_gt=tokenized_agent["gt_head_raw"][:, n_step],  # [n_agent]
+            valid_next_gt=tokenized_agent["gt_valid_raw"][:, n_step],  # [n_agent]
+            token_agent_shape=tokenized_agent["token_agent_shape"],  # [n_token, 2]
+        )  # next_token_idx: [n_agent], next_token_traj_all: [n_agent, 6, 4, 2]
+        return next_token_logits, next_token_idx, next_token_traj_all
+
+    def embed_next_action(
+        self,
+        next_token_idx,  # [n_agent]
+        next_token_traj_all,  # [n_agent, 6, 4, 2]
+        agent_token_emb_tables,  # (veh, ped, cyc), each [n_token, hidden_dim]
+        type_masks,  # (veh, ped, cyc), each [n_agent]
+    ):
+        """Action hook: embedding of the chosen action, looked up from the token tables."""
+        agent_token_emb_next = next_token_traj_all.new_zeros(
+            (next_token_idx.shape[0], self.hidden_dim)
+        )
+        for table, mask in zip(agent_token_emb_tables, type_masks):
+            agent_token_emb_next[mask] = table[next_token_idx[mask]]
+        return agent_token_emb_next
+
